"""
Diagnostic local de configuration.

Les valeurs sensibles ne sont jamais affichées : seules leur présence et
l'état du fichier .env sont indiqués.
"""
import os

from dotenv import find_dotenv, load_dotenv


chemin_trouve = find_dotenv(usecwd=True)
print("Fichier .env trouvé :", "oui" if chemin_trouve else "non")

if chemin_trouve:
    with open(chemin_trouve, "rb") as fichier:
        debut = fichier.read(4)
    if debut.startswith((b"\xff\xfe", b"\xfe\xff")):
        print("Encodage .env : UTF-16 détecté (convertir en UTF-8).")
    elif debut.startswith(b"\xef\xbb\xbf"):
        print("Encodage .env : BOM UTF-8 détecté.")

charge = load_dotenv(chemin_trouve or ".env", verbose=False, override=False)
print("Chargement dotenv :", "effectué" if charge else "aucun fichier chargé")

for nom in ("DATABASE_URL", "SUPABASE_URL", "GROQ_API_KEY"):
    configuree = bool(os.getenv(nom, "").strip())
    print(f"{nom} configurée :", "oui" if configuree else "non")
