# Copiez ce fichier en ".env" (a la racine du projet) et remplissez les
# valeurs. Le fichier ".env" ne doit JAMAIS etre commit (ajoutez-le au
# .gitignore, deja fait dans ce projet).

# --- Base de donnees ---
# Laissez vide pour rester sur SQLite local (mahay.db) comme en V1.
# Pour brancher Supabase : Project Settings > Database > Connection string
# > URI (choisissez "Transaction pooler" si vous deployez sur un hebergeur
# serverless, "Session pooler" ou connexion directe sinon).
DATABASE_URL=

# --- File IA Redis / Render Key Value ---
# En local, laissez vide pour utiliser uniquement le fallback PostgreSQL.
# Avec Redis local : redis://localhost:6379/0
REDIS_URL=
AI_QUEUE_REDIS_KEY=mahay:ai:queue

# --- Session ---
# Generez une vraie valeur secrete avant toute mise en ligne reelle, par
# exemple avec : python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=a-changer-en-production

# --- Stockage des documents (Supabase Storage) ---
# Laissez les deux vides pour rester sur le disque local (dossier uploads/).
# Sinon : Project Settings > API > Project URL / service_role key.
# Creez un bucket (Storage > New bucket), public si vous voulez que
# /documents/{id}/telecharger redirige directement vers un lien public.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# --- Generation de quiz par IA ---
# Cle GRATUITE (aucune carte bancaire requise) sur https://console.groq.com
# Console > API Keys > Create API Key.
GROQ_API_KEY=
# Modele principal : generation + arbitrage final.
GROQ_MODEL=openai/gpt-oss-120b
# Deuxieme modele Groq : critique independante du premier.
GROQ_CRITIC_MODEL=qwen/qwen3.8-27b

# Ensemble multi-modeles : true pour activer generation + critiques + arbitrage.
AI_ENSEMBLE_ENABLED=true
# Gemini ajoute un verificateur independant. Laisse true avec une GEMINI_API_KEY.
# Le Free Tier Gemini indique actuellement que les donnees peuvent etre utilisees
# pour ameliorer les produits Google ; ne fournis pas de contenu prive/sensible.
AI_ENSEMBLE_USE_GEMINI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

